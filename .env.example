# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# Local PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/balitech_db
#
# Render PostgreSQL (after deployment):
# DATABASE_URL=postgresql://user:password@your-db-host.postgres.render.com:5432/your_db_name
#
# Replace with your actual database URL
DATABASE_URL=postgresql://user:password@localhost:5432/balitech_db
